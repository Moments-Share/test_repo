# Anthropic APIキー（Vercelの Environment Variables に設定。ブラウザには出ません）
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# 使うモデル（任意。未設定なら claude-sonnet-5-5）
# 自分のAPIアカウントで使えるモデルIDを指定してください。
ANTHROPIC_MODEL=claude-sonnet-5-5

# 合言葉（任意）。設定すると、画面で合言葉を入れた人だけがAIを使える。
# URLを社外に渡すときは設定推奨（APIの利用料を守るため）。
APP_PASSCODE=
